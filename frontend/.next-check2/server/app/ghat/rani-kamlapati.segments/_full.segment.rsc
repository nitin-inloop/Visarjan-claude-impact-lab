e:["$","$L1b",null,{"slug":"rani-kamlapati","initial":{"slug":"rani-kamlapati","name":{"en":"Rani Kamlapati ghat / Kamla Park kund","hi":"रानी कमलापति घाट / कमला पार्क कुंड"},"water_body":"Lower Lake","water_body_name":{"en":"Lower Lake","hi":"छोटा तालाब (लोअर लेक)"},"ngt_lake_ban":true,"site_confidence":"medium","site_note":{"en":"Ganesh tables say 'Kamla Park kund', Durga tables say 'Lower Lake ghat'. These may be two places.","hi":"गणेश तालिकाओं में 'कमला पार्क कुंड' और दुर्गा तालिकाओं में 'लोअर लेक घाट' लिखा है। ये दो अलग जगहें हो सकती हैं।"},"rank":4,"tier":"high","tier_rule":{"en":"High: dissolved oxygen fell below 3 mg/l in Durga 2025 (2.4 mg/l during immersion).","hi":"उच्च: दुर्गा 2025 में घुलित ऑक्सीजन 3 mg/l से नीचे थी (विसर्जन के दौरान 2.4 mg/l)।"},"score":0.2082,"score_label":null,"breach_rate":0.4444,"coverage":1,"trend":"worsening","breach_rate_by_year":{"2023":0.333,"2024":0.5,"2025":0.5},"readings_available":54,"readings_expected":54,"coverage_by_table":{"Ganesh 2023":1,"Durga 2023":1,"Ganesh 2024":1,"Durga 2024":1,"Ganesh 2025":1,"Durga 2025":1},"reasons":[{"kind":"breach","parameter":"BOD","value":8.8,"unit":"mg/l","limit":"≤ 3","year":2025,"festival":"Durga","phase":"during","contribution":0.2578,"source":{"report":"MPPCB 2025","pdf":"2025","page":64},"text":{"en":"BOD was 8.8 mg/l during Durga 2025. The bathing limit is at most 3 mg/l. Source: MPPCB 2025 report, page 64.","hi":"दुर्गा 2025 के विसर्जन के दौरान बीओडी 8.8 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 64।"}},{"kind":"breach","parameter":"Dissolved oxygen","value":2.4,"unit":"mg/l","limit":"≥ 5","year":2025,"festival":"Durga","phase":"during","contribution":0.234,"source":{"report":"MPPCB 2025","pdf":"2025","page":64},"text":{"en":"Dissolved oxygen was 2.4 mg/l during Durga 2025. The bathing limit is at least 5 mg/l. Source: MPPCB 2025 report, page 64.","hi":"दुर्गा 2025 के विसर्जन के दौरान घुलित ऑक्सीजन 2.4 mg/l थी। स्नान मानक कम से कम 5 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 64।"}},{"kind":"breach","parameter":"Dissolved oxygen","value":2.6,"unit":"mg/l","limit":"≥ 5","year":2025,"festival":"Durga","phase":"after","contribution":0.216,"source":{"report":"MPPCB 2025","pdf":"2025","page":64},"text":{"en":"Dissolved oxygen was 2.6 mg/l one week after the Durga 2025 immersion. The bathing limit is at least 5 mg/l. Source: MPPCB 2025 report, page 64.","hi":"दुर्गा 2025 के विसर्जन के एक सप्ताह बाद घुलित ऑक्सीजन 2.6 mg/l थी। स्नान मानक कम से कम 5 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 64।"}},{"kind":"context","parameter":"Zinc","value":1.54,"unit":"mg/l","limit":"no CPCB bathing limit set","year":2024,"festival":"Ganesh","phase":"after","why":"spike","source":{"report":"MPPCB 2024","pdf":"2024","page":70},"text":{"en":"Zinc reached 1.54 mg/l one week after the Ganesh 2024 immersion, far above its usual level at these ghats. No CPCB bathing limit is set for zinc. Source: MPPCB 2024 report, page 70.","hi":"गणेश 2024 के विसर्जन के एक सप्ताह बाद जस्ता (ज़िंक) 1.54 mg/l था, जो इन घाटों के सामान्य स्तर से बहुत अधिक है। जस्ता (ज़िंक) के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 70।"}}],"actions":[{"code":"aerate","text":{"en":"Aerate: floating aerators, and dissolved-oxygen spot checks on immersion day and 7 days after.","hi":"एरेशन: तैरते एरेटर लगाएं; विसर्जन के दिन और 7 दिन बाद घुलित ऑक्सीजन की जांच करें।"}},{"code":"clean","text":{"en":"Clean: nirmalya collection point and an extra cleaning crew before and after immersion.","hi":"सफाई: निर्माल्य संग्रह केंद्र, और विसर्जन से पहले व बाद में अतिरिक्त सफाई दल।"}},{"code":"sample_metals","text":{"en":"Sample metals (chromium, lead, zinc, copper) during and after immersion.","hi":"धातु जांच: विसर्जन के दौरान और बाद में क्रोमियम, सीसा, जस्ता और तांबे का नमूना लें।"}},{"code":"lake_ban","text":{"en":"NGT ban on immersion in the lake: route idols to designated kunds; keep baseline testing. (Free Press Journal, 26 Feb 2026, listed in the data pack.)","hi":"झील में विसर्जन पर NGT की रोक: मूर्तियों को निर्धारित कुंडों में भेजें; नियमित जांच जारी रखें। (फ्री प्रेस जर्नल, 26 फरवरी 2026, डेटा पैक में सूचीबद्ध।)"}}],"forecast":{"available":true,"champion":"random_forest","p_breach":0.9751,"models":{"logreg":0.988,"random_forest":0.9751,"xgboost":0.9952,"lightgbm":0.9982},"basis":{"year":2025,"festival":"Durga","phase":"pre"},"top_reasons":[{"feature":"pre_bod","direction":"up","contribution":0.1371,"text":{"en":"Pre-immersion BOD (6.8) pushes the breach estimate up.","hi":"विसर्जन-पूर्व बीओडी (6.8) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"pre_do","direction":"up","contribution":0.0836,"text":{"en":"Pre-immersion dissolved oxygen (2.5) pushes the breach estimate up.","hi":"विसर्जन-पूर्व घुलित ऑक्सीजन (2.5) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"site_prior_breach_rate","direction":"up","contribution":0.0717,"text":{"en":"This site's breach record in earlier years (1) pushes the breach estimate up.","hi":"पिछले वर्षों में इस स्थल का उल्लंघन रिकॉर्ड (1) उल्लंघन की संभावना बढ़ाता है।"}}],"label":{"en":"Model estimate from 544 MP site-festival records (2023–25). Not a measurement.","hi":"मध्य प्रदेश के 544 स्थल-त्योहार रिकॉर्ड (2023–25) पर आधारित मॉडल अनुमान। यह मापन नहीं है।"}},"readings":[{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"pH","value":7.65,"unit":null,"flag":null,"value_as_printed":"7.65","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"pH","value":8.35,"unit":null,"flag":null,"value_as_printed":"8.35","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"pH","value":8.07,"unit":null,"flag":null,"value_as_printed":"8.07","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Total solids","value":300,"unit":"mg/l","f