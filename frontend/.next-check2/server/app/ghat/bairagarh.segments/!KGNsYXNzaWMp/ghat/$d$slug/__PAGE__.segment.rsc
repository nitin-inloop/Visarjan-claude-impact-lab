12:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[["$","$L14",null,{"slug":"bairagarh","initial":{"slug":"bairagarh","name":{"en":"Bairagarh (Sant Hirdaram) kund","hi":"बैरागढ़ (संत हिरदाराम) कुंड"},"water_body":"Upper Lake","water_body_name":{"en":"Upper Lake","hi":"बड़ा तालाब (अपर लेक)"},"ngt_lake_ban":true,"site_confidence":"high","site_note":null,"rank":1,"tier":"insufficient_data","tier_rule":{"en":"Insufficient data: no Durga 2025 test exists for this ghat. Score is on partial data.","hi":"अपर्याप्त डेटा: इस घाट की दुर्गा 2025 की कोई जांच नहीं है। स्कोर आंशिक डेटा पर है।"},"score":0.4614,"score_label":{"en":"on partial data","hi":"आंशिक डेटा पर"},"breach_rate":0.6154,"coverage":0.722,"trend":"stable","breach_rate_by_year":{"2023":0.611,"2024":0.611,"2025":0.667},"readings_available":39,"readings_expected":54,"coverage_by_table":{"Ganesh 2023":1,"Durga 2023":1,"Ganesh 2024":1,"Durga 2024":1,"Ganesh 2025":0.333,"Durga 2025":0},"reasons":[{"kind":"breach","parameter":"Dissolved oxygen","value":0,"unit":"mg/l","limit":"≥ 5","year":2025,"festival":"Ganesh","phase":"during","contribution":0.45,"source":{"report":"MPPCB 2025","pdf":"2025","page":28},"text":{"en":"Dissolved oxygen was 0 mg/l during Ganesh 2025. The bathing limit is at least 5 mg/l. Source: MPPCB 2025 report, page 28.","hi":"गणेश 2025 के विसर्जन के दौरान घुलित ऑक्सीजन 0 mg/l थी। स्नान मानक कम से कम 5 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 28।"}},{"kind":"breach","parameter":"BOD","value":13.2,"unit":"mg/l","limit":"≤ 3","year":2024,"festival":"Ganesh","phase":"during","contribution":0.3,"source":{"report":"MPPCB 2024","pdf":"2024","page":69},"text":{"en":"BOD was 13.2 mg/l during Ganesh 2024. The bathing limit is at most 3 mg/l. Source: MPPCB 2024 report, page 69.","hi":"गणेश 2024 के विसर्जन के दौरान बीओडी 13.2 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 69।"}},{"kind":"breach","parameter":"BOD","value":14,"unit":"mg/l","limit":"≤ 3","year":2024,"festival":"Ganesh","phase":"after","contribution":0.3,"source":{"report":"MPPCB 2024","pdf":"2024","page":69},"text":{"en":"BOD was 14 mg/l one week after the Ganesh 2024 immersion. The bathing limit is at most 3 mg/l. Source: MPPCB 2024 report, page 69.","hi":"गणेश 2024 के विसर्जन के एक सप्ताह बाद बीओडी 14 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 69।"}},{"kind":"context","parameter":"Lead","value":1.77,"unit":"mg/l","limit":"no CPCB bathing limit set","year":2024,"festival":"Ganesh","phase":"after","why":"highest","source":{"report":"MPPCB 2024","pdf":"2024","page":69},"text":{"en":"Lead reached 1.77 mg/l one week after the Ganesh 2024 immersion, the highest reading at any of the 7 ghats. No CPCB bathing limit is set for lead. Source: MPPCB 2024 report, page 69.","hi":"गणेश 2024 के विसर्जन के एक सप्ताह बाद सीसा (लेड) 1.77 mg/l था, जो 7 घाटों में सबसे अधिक है। सीसा (लेड) के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 69।"}},{"kind":"context","parameter":"Total solids","value":1574,"unit":"mg/l","limit":"no CPCB bathing limit set","year":2023,"festival":"Durga","phase":"after","why":"highest","source":{"report":"MPPCB 2023","pdf":"2023","page":60},"text":{"en":"Total solids reached 1574 mg/l one week after the Durga 2023 immersion, the highest reading at any of the 7 ghats. No CPCB bathing limit is set for total solids. Source: MPPCB 2023 report, page 60.","hi":"दुर्गा 2023 के विसर्जन के एक सप्ताह बाद कुल ठोस 1574 mg/l था, जो 7 घाटों में सबसे अधिक है। कुल ठोस के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2023 रिपोर्ट, पृष्ठ 60।"}},{"kind":"gap","parameter":null,"value":null,"unit":null,"limit":null,"year":2025,"festival":"Durga","phase":null,"parameters":["pH","Total solids","Dissolved solids","Suspended solids","Dissolved oxygen","BOD","COD","Turbidity","Conductivity","Chromium","Lead","Zinc","Copper"],"source":{"report":"MPPCB 2025","pdf":"2025","page":64},"text":{"en":"No Durga 2025 test exists for this ghat: the MPPCB 2025 report has no table for it (other Bhopal ghats are on pages 64–65).","hi":"इस घाट की दुर्गा 2025 की कोई जांच नहीं है: MPPCB 2025 रिपोर्ट में इसकी तालिका नहीं है (भोपाल के अन्य घाट पृष्ठ 64–65 पर हैं)।"}}],"actions":[{"code":"test_first","text":{"en":"Test first: pre-immersion sample by 17 Oct, then test all three phases this year.","hi":"पहले जांच: 17 अक्टूबर तक विसर्जन-पूर्व नमूना लें, फिर इस वर्ष तीनों चरणों में जांच करें।"}},{"code":"aerate","text":{"en":"Aerate: floating aerators, and dissolved-oxygen spot checks on immersion day and 7 days after.","hi":"एरेशन: तैरते एरेटर लगाएं; विसर्जन के दिन और 7 दिन बाद घुलित ऑक्सीजन की जांच करें।"}},{"code":"clean","text":{"en":"Clean: nirmalya collection point and an extra cleaning crew before and after immersion.","hi":"सफाई: निर्माल्य संग्रह केंद्र, और विसर्जन से पहले व बाद में अतिरिक्त सफाई दल।"}},{"code":"sample_metals","text":{"en":"Sample metals (chromium, lead, zinc, copper) during and after immersion.","hi":"धातु जांच: विसर्जन के दौरान और बाद में क्रोमियम, सीसा, जस्ता और तांबे का नमूना लें।"}},{"code":"lake_ban","text":{"en":"NGT ban on immersion in the lake: route idols to designated kunds; keep baseline testing. (Free Press Journal, 26 Feb 2026, listed in the data pack.)","hi":"झील में विसर्जन पर NGT की रोक: मूर्तियों को निर्धारित कुंडों में भेजें; नियमित जांच जारी रखें। (फ्री प्रेस जर्नल, 26 फरवरी 2026, डेटा पैक में सूचीबद्ध।)"}}],"forecast":{"available":true,"champion":"random_forest","p_breach":0.9172,"models":{"logreg":0.9789,"random_forest":0.9172,"xgboost":0.9932,"lightgbm":0.9974},"basis":{"year":2024,"festival":"Durga","phase":"pre"},"top_reasons":[{"feature":"pre_bod","direction":"up","contribution":0.1279,"text":{"en":"Pre-immersion BOD (6) pushes the breach estimate up.","hi":"विसर्जन-पूर्व बीओडी (6) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"pre_do","direction":"up","contribution":0.0952,"text":{"en":"Pre-immersion dissolved oxygen (4.2) pushes the breach estimate up.","hi":"विसर्जन-पूर्व घुलित ऑक्सीजन (4.2) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"site_prior_breach_rate","direction":"up","contribution":0.0628,"text":{"en":"This site's breach record in earlier years (1) pushes the breach estimate up.","hi":"पिछले वर्षों में इस स्थल का उल्लंघन रिकॉर्ड (1) उल्लंघन की संभावना बढ़ाता है।"}}],"label":{"en":"Model estimate from 544 MP site-festival records (2023–25). Not a measurement.","hi":"मध्य प्रदेश के 544 स्थल-त्योहार रिकॉर्ड (2023–25) पर आधारित मॉडल अनुमान। यह मापन नहीं है।"}},"readings":[{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"pH","value":7.71,"unit":null,"flag":null,"value_as_printed":"7.71","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"pH","value":7.37,"unit":null,"flag":null,"value_as_printed":"7.37","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"pH","value":7.2,"unit":null,"flag":null,"value_as_printed":"7.2","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Total solids","value":818,"unit":"mg/l","flag":null,"value_as_printed":"818","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"Total solids","value":832,"unit":"mg/l","flag":null,"value_as_printed":"832","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"Total solids","value":950,"unit":"mg/l","flag":null,"value_as_printed":"950","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Dissolved solids","value":794,"unit":"mg/l","flag":null,"value_as_printed":"794","limit_class_b":null,"lim