12:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[["$","$L14",null,{"slug":"malikhedi","initial":{"slug":"malikhedi","name":{"en":"Malikhedi kund","hi":"मालीखेड़ी कुंड"},"water_body":"Kund","water_body_name":{"en":"Kund","hi":"कुंड"},"ngt_lake_ban":false,"site_confidence":"high","site_note":null,"rank":2,"tier":"insufficient_data","tier_rule":{"en":"Insufficient data: no Durga 2025 test exists for this ghat. Score is on partial data.","hi":"अपर्याप्त डेटा: इस घाट की दुर्गा 2025 की कोई जांच नहीं है। स्कोर आंशिक डेटा पर है।"},"score":0.2554,"score_label":{"en":"on partial data","hi":"आंशिक डेटा पर"},"breach_rate":0.5128,"coverage":0.722,"trend":"worsening","breach_rate_by_year":{"2023":0.389,"2024":0.611,"2025":0.667},"readings_available":39,"readings_expected":54,"coverage_by_table":{"Ganesh 2023":1,"Durga 2023":1,"Ganesh 2024":1,"Durga 2024":1,"Ganesh 2025":0.333,"Durga 2025":0},"reasons":[{"kind":"breach","parameter":"Dissolved oxygen","value":0.6,"unit":"mg/l","limit":"≥ 5","year":2025,"festival":"Ganesh","phase":"during","contribution":0.396,"source":{"report":"MPPCB 2025","pdf":"2025","page":29},"text":{"en":"Dissolved oxygen was 0.6 mg/l during Ganesh 2025. The bathing limit is at least 5 mg/l. Source: MPPCB 2025 report, page 29.","hi":"गणेश 2025 के विसर्जन के दौरान घुलित ऑक्सीजन 0.6 mg/l थी। स्नान मानक कम से कम 5 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 29।"}},{"kind":"breach","parameter":"BOD","value":16.8,"unit":"mg/l","limit":"≤ 3","year":2023,"festival":"Ganesh","phase":"after","contribution":0.2,"source":{"report":"MPPCB 2023","pdf":"2023","page":27},"text":{"en":"BOD was 16.8 mg/l one week after the Ganesh 2023 immersion. The bathing limit is at most 3 mg/l. Source: MPPCB 2023 report, page 27.","hi":"गणेश 2023 के विसर्जन के एक सप्ताह बाद बीओडी 16.8 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2023 रिपोर्ट, पृष्ठ 27।"}},{"kind":"breach","parameter":"BOD","value":8.4,"unit":"mg/l","limit":"≤ 3","year":2024,"festival":"Ganesh","phase":"after","contribution":0.18,"source":{"report":"MPPCB 2024","pdf":"2024","page":71},"text":{"en":"BOD was 8.4 mg/l one week after the Ganesh 2024 immersion. The bathing limit is at most 3 mg/l. Source: MPPCB 2024 report, page 71.","hi":"गणेश 2024 के विसर्जन के एक सप्ताह बाद बीओडी 8.4 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 71।"}},{"kind":"gap","parameter":null,"value":null,"unit":null,"limit":null,"year":2025,"festival":"Durga","phase":null,"parameters":["pH","Total solids","Dissolved solids","Suspended solids","Dissolved oxygen","BOD","COD","Turbidity","Conductivity","Chromium","Lead","Zinc","Copper"],"source":{"report":"MPPCB 2025","pdf":"2025","page":64},"text":{"en":"No Durga 2025 test exists for this ghat: the MPPCB 2025 report has no table for it (other Bhopal ghats are on pages 64–65).","hi":"इस घाट की दुर्गा 2025 की कोई जांच नहीं है: MPPCB 2025 रिपोर्ट में इसकी तालिका नहीं है (भोपाल के अन्य घाट पृष्ठ 64–65 पर हैं)।"}}],"actions":[{"code":"test_first","text":{"en":"Test first: pre-immersion sample by 17 Oct, then test all three phases this year.","hi":"पहले जांच: 17 अक्टूबर तक विसर्जन-पूर्व नमूना लें, फिर इस वर्ष तीनों चरणों में जांच करें।"}},{"code":"aerate","text":{"en":"Aerate: floating aerators, and dissolved-oxygen spot checks on immersion day and 7 days after.","hi":"एरेशन: तैरते एरेटर लगाएं; विसर्जन के दिन और 7 दिन बाद घुलित ऑक्सीजन की जांच करें।"}},{"code":"clean","text":{"en":"Clean: nirmalya collection point and an extra cleaning crew before and after immersion.","hi":"सफाई: निर्माल्य संग्रह केंद्र, और विसर्जन से पहले व बाद में अतिरिक्त सफाई दल।"}}],"forecast":{"available":true,"champion":"random_forest","p_breach":0.9536,"models":{"logreg":0.9904,"random_forest":0.9536,"xgboost":0.9949,"lightgbm":0.9983},"basis":{"year":2024,"festival":"Durga","phase":"pre"},"top_reasons":[{"feature":"pre_bod","direction":"up","contribution":0.137,"text":{"en":"Pre-immersion BOD (6.8) pushes the breach estimate up.","hi":"विसर्जन-पूर्व बीओडी (6.8) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"pre_do","direction":"up","contribution":0.1031,"text":{"en":"Pre-immersion dissolved oxygen (4.5) pushes the breach estimate up.","hi":"विसर्जन-पूर्व घुलित ऑक्सीजन (4.5) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"site_prior_breach_rate","direction":"up","contribution":0.0654,"text":{"en":"This site's breach record in earlier years (1) pushes the breach estimate up.","hi":"पिछले वर्षों में इस स्थल का उल्लंघन रिकॉर्ड (1) उल्लंघन की संभावना बढ़ाता है।"}}],"label":{"en":"Model estimate from 544 MP site-festival records (2023–25). Not a measurement.","hi":"मध्य प्रदेश के 544 स्थल-त्योहार रिकॉर्ड (2023–25) पर आधारित मॉडल अनुमान। यह मापन नहीं है।"}},"readings":[{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"pH","value":7.65,"unit":null,"flag":null,"value_as_printed":"7.65","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"pH","value":7.81,"unit":null,"flag":null,"value_as_printed":"7.81","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"pH","value":7.11,"unit":null,"flag":null,"value_as_printed":"7.11","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Total solids","value":348,"unit":"mg/l","flag":null,"value_as_printed":"348","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"Total solids","value":365,"unit":"mg/l","flag":null,"value_as_printed":"365","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"Total solids","value":800,"unit":"mg/l","flag":null,"value_as_printed":"800","limit_class_b":null,"limit_class