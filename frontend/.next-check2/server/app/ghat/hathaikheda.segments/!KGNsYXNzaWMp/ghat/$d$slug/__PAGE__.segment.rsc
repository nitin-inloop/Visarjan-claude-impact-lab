12:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[["$","$L14",null,{"slug":"hathaikheda","initial":{"slug":"hathaikheda","name":{"en":"Hathaikheda dam / kund","hi":"हथाईखेड़ा डैम / कुंड"},"water_body":"Hathaikheda dam","water_body_name":{"en":"Hathaikheda dam","hi":"हथाईखेड़ा डैम"},"ngt_lake_ban":false,"site_confidence":"high","site_note":null,"rank":5,"tier":"medium","tier_rule":{"en":"Medium: BOD was above the bathing limit of 3 mg/l in 12 of 12 readings since 2024 (median 7 mg/l, at least twice the limit), even though dissolved oxygen held up.","hi":"मध्यम: 2024 से बीओडी 12 में से 12 रीडिंग में स्नान मानक 3 mg/l से अधिक रहा (माध्यिका 7 mg/l, मानक से कम से कम दोगुना), हालांकि घुलित ऑक्सीजन ठीक रही।"},"score":0.1992,"score_label":null,"breach_rate":0.3519,"coverage":1,"trend":"stable","breach_rate_by_year":{"2023":0.278,"2024":0.389,"2025":0.389},"readings_available":54,"readings_expected":54,"coverage_by_table":{"Ganesh 2023":1,"Durga 2023":1,"Ganesh 2024":1,"Durga 2024":1,"Ganesh 2025":1,"Durga 2025":1},"reasons":[{"kind":"breach","parameter":"BOD","value":10,"unit":"mg/l","limit":"≤ 3","year":2025,"festival":"Ganesh","phase":"during","contribution":0.3111,"source":{"report":"MPPCB 2025","pdf":"2025","page":29},"text":{"en":"BOD was 10 mg/l during Ganesh 2025. The bathing limit is at most 3 mg/l. Source: MPPCB 2025 report, page 29.","hi":"गणेश 2025 के विसर्जन के दौरान बीओडी 10 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 29।"}},{"kind":"breach","parameter":"BOD","value":13.2,"unit":"mg/l","limit":"≤ 3","year":2024,"festival":"Ganesh","phase":"during","contribution":0.3,"source":{"report":"MPPCB 2024","pdf":"2024","page":71},"text":{"en":"BOD was 13.2 mg/l during Ganesh 2024. The bathing limit is at most 3 mg/l. Source: MPPCB 2024 report, page 71.","hi":"गणेश 2024 के विसर्जन के दौरान बीओडी 13.2 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 71।"}},{"kind":"breach","parameter":"pH","value":9.2,"unit":null,"limit":"6.5–8.5","year":2024,"festival":"Durga","phase":"pre","contribution":0.0394,"source":{"report":"MPPCB 2024","pdf":"2024","page":23},"text":{"en":"pH was 9.2 before the Durga 2024 immersion. The bathing range is 6.5 to 8.5. Source: MPPCB 2024 report, page 23.","hi":"दुर्गा 2024 के विसर्जन से पहले पीएच 9.2 था। स्नान मानक 6.5 से 8.5 के बीच है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 23।"}},{"kind":"context","parameter":"Zinc","value":2.67,"unit":"mg/l","limit":"no CPCB bathing limit set","year":2024,"festival":"Ganesh","phase":"after","why":"highest","source":{"report":"MPPCB 2024","pdf":"2024","page":71},"text":{"en":"Zinc reached 2.67 mg/l one week after the Ganesh 2024 immersion, the highest reading at any of the 7 ghats. No CPCB bathing limit is set for zinc. Source: MPPCB 2024 report, page 71.","hi":"गणेश 2024 के विसर्जन के एक सप्ताह बाद जस्ता (ज़िंक) 2.67 mg/l था, जो 7 घाटों में सबसे अधिक है। जस्ता (ज़िंक) के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 71।"}},{"kind":"context","parameter":"Turbidity","value":193.5,"unit":"NTU","limit":"no CPCB bathing limit set","year":2024,"festival":"Ganesh","phase":"after","why":"highest","source":{"report":"MPPCB 2024","pdf":"2024","page":71},"text":{"en":"Turbidity reached 193.5 NTU one week after the Ganesh 2024 immersion, the highest reading at any of the 7 ghats. No CPCB bathing limit is set for turbidity. Source: MPPCB 2024 report, page 71.","hi":"गणेश 2024 के विसर्जन के एक सप्ताह बाद गंदलापन (टर्बिडिटी) 193.5 NTU था, जो 7 घाटों में सबसे अधिक है। गंदलापन (टर्बिडिटी) के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 71।"}}],"actions":[{"code":"clean","text":{"en":"Clean: nirmalya collection point and an extra cleaning crew before and after immersion.","hi":"सफाई: निर्माल्य संग्रह केंद्र, और विसर्जन से पहले व बाद में अतिरिक्त सफाई दल।"}},{"code":"sample_metals","text":{"en":"Sample metals (chromium, lead, zinc, copper) during and after immersion.","hi":"धातु जांच: विसर्जन के दौरान और बाद में क्रोमियम, सीसा, जस्ता और तांबे का नमूना लें।"}}],"forecast":{"available":true,"champion":"random_forest","p_breach":0.9133,"models":{"logreg":0.8316,"random_forest":0.9133,"xgboost":0.9763,"lightgbm":0.9924},"basis":{"year":2025,"festival":"Durga","phase":"pre"},"top_reasons":[{"feature":"pre_bod","direction":"up","contribution":0.1571,"text":{"en":"Pre-immersion BOD (6.8) pushes the breach estimate up.","hi":"विसर्जन-पूर्व बीओडी (6.8) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"site_prior_breach_rate","direction":"up","contribution":0.0936,"text":{"en":"This site's breach record in earlier years (1) pushes the breach estimate up.","hi":"पिछले वर्षों में इस स्थल का उल्लंघन रिकॉर्ड (1) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"pre_turbidity","direction":"up","contribution":0.0784,"text":{"en":"Pre-immersion turbidity (41.1) pushes the breach estimate up.","hi":"विसर्जन-पूर्व गंदलापन (41.1) उल्लंघन की संभावना बढ़ाता है।"}}],"label":{"en":"Model estimate from 544 MP site-festival records (2023–25). Not a measurement.","hi":"मध्य प्रदेश के 544 स्थल-त्योहार रिकॉर्ड (2023–25) पर आधारित मॉडल अनुमान। यह मापन नहीं है।"}},"readings":[{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"pH","value":8.1,"unit":null,"flag":null,"value_as_printed":"8.1","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"pH","value":8.92,"unit":null,"flag":null,"value_as_printed":"8.92","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"breach","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"pH","value":8.01,"unit":null,"flag":null,"value_as_printed":"8.01","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":27,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Total solids","value":374,"unit":"mg/l","flag":null,"value_as_printed":"374","limit_class_b":null,"limit_class_c":null,"st