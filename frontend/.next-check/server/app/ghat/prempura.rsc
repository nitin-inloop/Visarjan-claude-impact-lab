e:["$","$L1b",null,{"slug":"prempura","initial":{"slug":"prempura","name":{"en":"Prempura ghat","hi":"प्रेमपुरा घाट"},"water_body":"Upper Lake","water_body_name":{"en":"Upper Lake","hi":"बड़ा तालाब (अपर लेक)"},"ngt_lake_ban":true,"site_confidence":"high","site_note":null,"rank":7,"tier":"low","tier_rule":{"en":"Low: risk score 0.05 is below 0.25. BOD still exceeded 3 mg/l in 9 of 12 readings since 2024 (median 3.9 mg/l). Lower risk than the other ghats, not clean.","hi":"निम्न: जोखिम स्कोर 0.05 है, जो 0.25 से कम है। फिर भी 2024 से बीओडी 12 में से 9 रीडिंग में 3 mg/l से अधिक रहा (माध्यिका 3.9 mg/l)। अन्य घाटों से कम जोखिम, पर स्वच्छ नहीं।"},"score":0.0535,"score_label":null,"breach_rate":0.28,"coverage":0.926,"trend":"worsening","breach_rate_by_year":{"2023":0.071,"2024":0.389,"2025":0.333},"readings_available":50,"readings_expected":54,"coverage_by_table":{"Ganesh 2023":1,"Durga 2023":0.556,"Ganesh 2024":1,"Durga 2024":1,"Ganesh 2025":1,"Durga 2025":1},"reasons":[{"kind":"breach","parameter":"BOD","value":6.8,"unit":"mg/l","limit":"≤ 3","year":2024,"festival":"Ganesh","phase":"during","contribution":0.1267,"source":{"report":"MPPCB 2024","pdf":"2024","page":70},"text":{"en":"BOD was 6.8 mg/l during Ganesh 2024. The bathing limit is at most 3 mg/l. Source: MPPCB 2024 report, page 70.","hi":"गणेश 2024 के विसर्जन के दौरान बीओडी 6.8 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 70।"}},{"kind":"breach","parameter":"BOD","value":4.8,"unit":"mg/l","limit":"≤ 3","year":2025,"festival":"Durga","phase":"during","contribution":0.08,"source":{"report":"MPPCB 2025","pdf":"2025","page":65},"text":{"en":"BOD was 4.8 mg/l during Durga 2025. The bathing limit is at most 3 mg/l. Source: MPPCB 2025 report, page 65.","hi":"दुर्गा 2025 के विसर्जन के दौरान बीओडी 4.8 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 65।"}},{"kind":"breach","parameter":"Dissolved oxygen","value":3.9,"unit":"mg/l","limit":"≥ 5","year":2024,"festival":"Ganesh","phase":"during","contribution":0.0743,"source":{"report":"MPPCB 2024","pdf":"2024","page":70},"text":{"en":"Dissolved oxygen was 3.9 mg/l during Ganesh 2024. The bathing limit is at least 5 mg/l. Source: MPPCB 2024 report, page 70.","hi":"गणेश 2024 के विसर्जन के दौरान घुलित ऑक्सीजन 3.9 mg/l थी। स्नान मानक कम से कम 5 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 70।"}},{"kind":"gap","parameter":null,"value":null,"unit":null,"limit":null,"year":2023,"festival":"Durga","phase":"pre","parameters":["BOD"],"source":{"report":"MPPCB 2023","pdf":"2023","page":60},"text":{"en":"BOD not sampled before immersion in Durga 2023 (blank or '_' in the report). Page 60.","hi":"दुर्गा 2023 में विसर्जन से पहले बीओडी की जांच नहीं हुई (रिपोर्ट में खाली या '_')। पृष्ठ 60।"}}],"actions":[{"code":"clean","text":{"en":"Clean: nirmalya collection point and an extra cleaning crew before and after immersion.","hi":"सफाई: निर्माल्य संग्रह केंद्र, और विसर्जन से पहले व बाद में अतिरिक्त सफाई दल।"}},{"code":"lake_ban","text":{"en":"NGT ban on immersion in the lake: route idols to designated kunds; keep baseline testing. (Free Press Journal, 26 Feb 2026, listed in the data pack.)","hi":"झील में विसर्जन पर NGT की रोक: मूर्तियों को निर्धारित कुंडों में भेजें; नियमित जांच जारी रखें। (फ्री प्रेस जर्नल, 26 फरवरी 2026, डेटा पैक में सूचीबद्ध।)"}}],"forecast":{"available":true,"champion":"random_forest","p_breach":0.8873,"models":{"logreg":0.8591,"random_forest":0.8873,"xgboost":0.9825,"lightgbm":0.9879},"basis":{"year":2025,"festival":"Durga","phase":"pre"},"top_reasons":[{"feature":"pre_bod","direction":"up","contribution":0.1696,"text":{"en":"Pre-immersion BOD (4.4) pushes the breach estimate up.","hi":"विसर्जन-पूर्व बीओडी (4.4) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"site_prior_breach_rate","direction":"up","contribution":0.0419,"text":{"en":"This site's breach record in earlier years (0.667) pushes the breach estimate up.","hi":"पिछले वर्षों में इस स्थल का उल्लंघन रिकॉर्ड (0.667) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"ro_bhopal","direction":"up","contribution":0.0399,"text":{"en":"Regional office bhopal pushes the breach estimate up.","hi":"क्षेत्रीय कार्यालय bhopal उल्लंघन की संभावना बढ़ाता है।"}}],"label":{"en":"Model estimate from 544 MP site-festival records (2023–25). Not a measurement.","hi":"मध्य प्रदेश के 544 स्थल-त्योहार रिकॉर्ड (2023–25) पर आधारित मॉडल अनुमान। यह मापन नहीं है।"}},"readings":[{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"pH","value":7.72,"unit":null,"flag":null,"value_as_printed":"7.72","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"pH","value":8.53,"unit":null,"flag":null,"value_as_printed":"8.53","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"breach","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"pH","value":7.44,"unit":null,"flag":null,"value_as_printed":"7.44","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Total solids","value":386,"unit":"mg/l","flag":null,"value_as_printed":"386","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"Total solids","value":216,"unit":"mg/l","flag":null,"value_as_printed":"216","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"Total solids","value":270,"unit":"mg/l","flag":null,"value_as_printed":"270","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Dissolved solids","value":338,"unit":"mg/l","flag":null,"value_as_printed":"338","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":26,"pdf":"2023"},{"year":2023,"festival":"Ganesh","pha