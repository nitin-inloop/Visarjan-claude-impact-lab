12:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[["$","$L14",null,{"slug":"khatlapura","initial":{"slug":"khatlapura","name":{"en":"Khatlapura ghat","hi":"खटलापुरा घाट"},"water_body":"Lower Lake","water_body_name":{"en":"Lower Lake","hi":"छोटा तालाब (लोअर लेक)"},"ngt_lake_ban":true,"site_confidence":"high","site_note":null,"rank":6,"tier":"low","tier_rule":{"en":"Low: risk score 0.15 is below 0.25. BOD still exceeded 3 mg/l in 12 of 12 readings since 2024 (median 5.8 mg/l). Lower risk than the other ghats, not clean.","hi":"निम्न: जोखिम स्कोर 0.15 है, जो 0.25 से कम है। फिर भी 2024 से बीओडी 12 में से 12 रीडिंग में 3 mg/l से अधिक रहा (माध्यिका 5.8 mg/l)। अन्य घाटों से कम जोखिम, पर स्वच्छ नहीं।"},"score":0.1514,"score_label":null,"breach_rate":0.4528,"coverage":0.981,"trend":"stable","breach_rate_by_year":{"2023":0.353,"2024":0.667,"2025":0.333},"readings_available":53,"readings_expected":54,"coverage_by_table":{"Ganesh 2023":1,"Durga 2023":0.889,"Ganesh 2024":1,"Durga 2024":1,"Ganesh 2025":1,"Durga 2025":1},"reasons":[{"kind":"breach","parameter":"BOD","value":11.2,"unit":"mg/l","limit":"≤ 3","year":2023,"festival":"Ganesh","phase":"after","contribution":0.1822,"source":{"report":"MPPCB 2023","pdf":"2023","page":26},"text":{"en":"BOD was 11.2 mg/l one week after the Ganesh 2023 immersion. The bathing limit is at most 3 mg/l. Source: MPPCB 2023 report, page 26.","hi":"गणेश 2023 के विसर्जन के एक सप्ताह बाद बीओडी 11.2 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2023 रिपोर्ट, पृष्ठ 26।"}},{"kind":"breach","parameter":"BOD","value":8.4,"unit":"mg/l","limit":"≤ 3","year":2024,"festival":"Durga","phase":"after","contribution":0.18,"source":{"report":"MPPCB 2024","pdf":"2024","page":24},"text":{"en":"BOD was 8.4 mg/l one week after the Durga 2024 immersion. The bathing limit is at most 3 mg/l. Source: MPPCB 2024 report, page 24.","hi":"दुर्गा 2024 के विसर्जन के एक सप्ताह बाद बीओडी 8.4 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 24।"}},{"kind":"breach","parameter":"Dissolved oxygen","value":4,"unit":"mg/l","limit":"≥ 5","year":2024,"festival":"Ganesh","phase":"during","contribution":0.0675,"source":{"report":"MPPCB 2024","pdf":"2024","page":69},"text":{"en":"Dissolved oxygen was 4 mg/l during Ganesh 2024. The bathing limit is at least 5 mg/l. Source: MPPCB 2024 report, page 69.","hi":"गणेश 2024 के विसर्जन के दौरान घुलित ऑक्सीजन 4 mg/l थी। स्नान मानक कम से कम 5 mg/l है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 69।"}},{"kind":"context","parameter":"Chromium","value":1.98,"unit":"mg/l","limit":"no CPCB bathing limit set","year":2024,"festival":"Ganesh","phase":"during","why":"highest","source":{"report":"MPPCB 2024","pdf":"2024","page":69},"text":{"en":"Chromium reached 1.98 mg/l during Ganesh 2024, the highest reading at any of the 7 ghats. No CPCB bathing limit is set for chromium. Source: MPPCB 2024 report, page 69.","hi":"गणेश 2024 के विसर्जन के दौरान क्रोमियम 1.98 mg/l था, जो 7 घाटों में सबसे अधिक है। क्रोमियम के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 69।"}},{"kind":"context","parameter":"Copper","value":2.66,"unit":"mg/l","limit":"no CPCB bathing limit set","year":2024,"festival":"Ganesh","phase":"during","why":"highest","source":{"report":"MPPCB 2024","pdf":"2024","page":69},"text":{"en":"Copper reached 2.66 mg/l during Ganesh 2024, the highest reading at any of the 7 ghats. No CPCB bathing limit is set for copper. Source: MPPCB 2024 report, page 69.","hi":"गणेश 2024 के विसर्जन के दौरान तांबा (कॉपर) 2.66 mg/l था, जो 7 घाटों में सबसे अधिक है। तांबा (कॉपर) के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 69।"}},{"kind":"gap","parameter":null,"value":null,"unit":null,"limit":null,"year":2023,"festival":"Durga","phase":"during","parameters":["BOD"],"source":{"report":"MPPCB 2023","pdf":"2023","page":59},"text":{"en":"BOD not sampled during immersion in Durga 2023 (blank or '_' in the report). Page 59.","hi":"दुर्गा 2023 में विसर्जन के दौरान बीओडी की जांच नहीं हुई (रिपोर्ट में खाली या '_')। पृष्ठ 59।"}}],"actions":[{"code":"clean","text":{"en":"Clean: nirmalya collection point and an extra cleaning crew before and after immersion.","hi":"सफाई: निर्माल्य संग्रह केंद्र, और विसर्जन से पहले व बाद में अतिरिक्त सफाई दल।"}},{"code":"sample_metals","text":{"en":"Sample metals (chromium, lead, zinc, copper) during and after immersion.","hi":"धातु जांच: विसर्जन के दौरान और बाद में क्रोमियम, सीसा, जस्ता और तांबे का नमूना लें।"}},{"code":"lake_ban","text":{"en":"NGT ban on immersion in the lake: route idols to designated kunds; keep baseline testing. (Free Press Journal, 26 Feb 2026, listed in the data pack.)","hi":"झील में विसर्जन पर NGT की रोक: मूर्तियों को निर्धारित कुंडों में भेजें; नियमित जांच जारी रखें। (फ्री प्रेस जर्नल, 26 फरवरी 2026, डेटा पैक में सूचीबद्ध।)"}}],"forecast":{"available":true,"champion":"random_forest","p_breach":0.9095,"models":{"logreg":0.7243,"random_forest":0.9095,"xgboost":0.9836,"lightgbm":0.9869},"basis":{"year":2025,"festival":"Durga","phase":"pre"},"top_reasons":[{"feature":"pre_bod","direction":"up","contribution":0.183,"text":{"en":"Pre-immersion BOD (4.4) pushes the breach estimate up.","hi":"विसर्जन-पूर्व बीओडी (4.4) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"site_prior_breach_rate","direction":"up","contribution":0.0995,"text":{"en":"This site's breach record in earlier years (1) pushes the breach estimate up.","hi":"पिछले वर्षों में इस स्थल का उल्लंघन रिकॉर्ड (1) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"ro_bhopal","direction":"up","contribution":0.0502,"text":{"en":"Regional office bhopal pushes the breach estimate up.","hi":"क्षेत्रीय कार्यालय bhopal उल्लंघन की संभावना बढ़ाता है।"}}],"label":{"en":"Model estimate from 544 MP site-festival records (2023–25). Not a measurement.","hi":"मध्य प्रदेश के 544 स्थल-त्योहार रिकॉर्ड (2023–25) पर आधारित मॉडल अनुमान। यह मापन नहीं है।"}},"readings":[{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"pH","value":6.98,"unit":nu