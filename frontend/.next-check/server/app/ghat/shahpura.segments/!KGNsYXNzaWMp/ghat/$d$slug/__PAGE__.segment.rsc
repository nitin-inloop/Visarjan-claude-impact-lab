12:[["children",{"s":"__PAGE__","h":160,"d":{"r":["$","$1","c",{"children":[["$","$L14",null,{"slug":"shahpura","initial":{"slug":"shahpura","name":{"en":"Shahpura lake ghat","hi":"शाहपुरा झील घाट"},"water_body":"Shahpura Lake","water_body_name":{"en":"Shahpura Lake","hi":"शाहपुरा झील"},"ngt_lake_ban":false,"site_confidence":"high","site_note":null,"rank":3,"tier":"high","tier_rule":{"en":"High: dissolved oxygen fell below 3 mg/l in Durga 2025 (2.5 mg/l before immersion).","hi":"उच्च: दुर्गा 2025 में घुलित ऑक्सीजन 3 mg/l से नीचे थी (विसर्जन से पहले 2.5 mg/l)।"},"score":0.2736,"score_label":null,"breach_rate":0.4259,"coverage":1,"trend":"stable","breach_rate_by_year":{"2023":0.444,"2024":0.389,"2025":0.444},"readings_available":54,"readings_expected":54,"coverage_by_table":{"Ganesh 2023":1,"Durga 2023":1,"Ganesh 2024":1,"Durga 2024":1,"Ganesh 2025":1,"Durga 2025":1},"reasons":[{"kind":"breach","parameter":"BOD","value":11.4,"unit":"mg/l","limit":"≤ 3","year":2025,"festival":"Durga","phase":"during","contribution":0.3733,"source":{"report":"MPPCB 2025","pdf":"2025","page":65},"text":{"en":"BOD was 11.4 mg/l during Durga 2025. The bathing limit is at most 3 mg/l. Source: MPPCB 2025 report, page 65.","hi":"दुर्गा 2025 के विसर्जन के दौरान बीओडी 11.4 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 65।"}},{"kind":"breach","parameter":"BOD","value":10.4,"unit":"mg/l","limit":"≤ 3","year":2025,"festival":"Durga","phase":"after","contribution":0.3289,"source":{"report":"MPPCB 2025","pdf":"2025","page":65},"text":{"en":"BOD was 10.4 mg/l one week after the Durga 2025 immersion. The bathing limit is at most 3 mg/l. Source: MPPCB 2025 report, page 65.","hi":"दुर्गा 2025 के विसर्जन के एक सप्ताह बाद बीओडी 10.4 mg/l था। स्नान मानक अधिकतम 3 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 65।"}},{"kind":"breach","parameter":"Dissolved oxygen","value":2.8,"unit":"mg/l","limit":"≥ 5","year":2025,"festival":"Durga","phase":"during","contribution":0.198,"source":{"report":"MPPCB 2025","pdf":"2025","page":65},"text":{"en":"Dissolved oxygen was 2.8 mg/l during Durga 2025. The bathing limit is at least 5 mg/l. Source: MPPCB 2025 report, page 65.","hi":"दुर्गा 2025 के विसर्जन के दौरान घुलित ऑक्सीजन 2.8 mg/l थी। स्नान मानक कम से कम 5 mg/l है। स्रोत: MPPCB 2025 रिपोर्ट, पृष्ठ 65।"}},{"kind":"context","parameter":"Copper","value":1.638,"unit":"mg/l","limit":"no CPCB bathing limit set","year":2024,"festival":"Ganesh","phase":"after","why":"spike","source":{"report":"MPPCB 2024","pdf":"2024","page":72},"text":{"en":"Copper reached 1.638 mg/l one week after the Ganesh 2024 immersion, far above its usual level at these ghats. No CPCB bathing limit is set for copper. Source: MPPCB 2024 report, page 72.","hi":"गणेश 2024 के विसर्जन के एक सप्ताह बाद तांबा (कॉपर) 1.638 mg/l था, जो इन घाटों के सामान्य स्तर से बहुत अधिक है। तांबा (कॉपर) के लिए CPCB स्नान मानक तय नहीं है। स्रोत: MPPCB 2024 रिपोर्ट, पृष्ठ 72।"}}],"actions":[{"code":"aerate","text":{"en":"Aerate: floating aerators, and dissolved-oxygen spot checks on immersion day and 7 days after.","hi":"एरेशन: तैरते एरेटर लगाएं; विसर्जन के दिन और 7 दिन बाद घुलित ऑक्सीजन की जांच करें।"}},{"code":"clean","text":{"en":"Clean: nirmalya collection point and an extra cleaning crew before and after immersion.","hi":"सफाई: निर्माल्य संग्रह केंद्र, और विसर्जन से पहले व बाद में अतिरिक्त सफाई दल।"}},{"code":"sample_metals","text":{"en":"Sample metals (chromium, lead, zinc, copper) during and after immersion.","hi":"धातु जांच: विसर्जन के दौरान और बाद में क्रोमियम, सीसा, जस्ता और तांबे का नमूना लें।"}}],"forecast":{"available":true,"champion":"random_forest","p_breach":0.953,"models":{"logreg":0.9946,"random_forest":0.953,"xgboost":0.9928,"lightgbm":0.9985},"basis":{"year":2025,"festival":"Durga","phase":"pre"},"top_reasons":[{"feature":"pre_bod","direction":"up","contribution":0.1421,"text":{"en":"Pre-immersion BOD (6.8) pushes the breach estimate up.","hi":"विसर्जन-पूर्व बीओडी (6.8) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"pre_do","direction":"up","contribution":0.0932,"text":{"en":"Pre-immersion dissolved oxygen (2.5) pushes the breach estimate up.","hi":"विसर्जन-पूर्व घुलित ऑक्सीजन (2.5) उल्लंघन की संभावना बढ़ाता है।"}},{"feature":"pre_turbidity","direction":"up","contribution":0.0778,"text":{"en":"Pre-immersion turbidity (31.4) pushes the breach estimate up.","hi":"विसर्जन-पूर्व गंदलापन (31.4) उल्लंघन की संभावना बढ़ाता है।"}}],"label":{"en":"Model estimate from 544 MP site-festival records (2023–25). Not a measurement.","hi":"मध्य प्रदेश के 544 स्थल-त्योहार रिकॉर्ड (2023–25) पर आधारित मॉडल अनुमान। यह मापन नहीं है।"}},"readings":[{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"pH","value":7.32,"unit":null,"flag":null,"value_as_printed":"7.32","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":28,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"pH","value":7.36,"unit":null,"flag":null,"value_as_printed":"7.36","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":28,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"pH","value":7.76,"unit":null,"flag":null,"value_as_printed":"7.76","limit_class_b":"6.5–8.5","limit_class_c":"6–9","status":"ok","page":28,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pre","parameter":"Total solids","value":432,"unit":"mg/l","flag":null,"value_as_printed":"432","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":28,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"during","parameter":"Total solids","value":480,"unit":"mg/l","flag":null,"value_as_printed":"480","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":28,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"after","parameter":"Total solids","value":604,"unit":"mg/l","flag":null,"value_as_printed":"604","limit_class_b":null,"limit_class_c":null,"status":"no_limit","page":28,"pdf":"2023"},{"year":2023,"festival":"Ganesh","phase":"pr