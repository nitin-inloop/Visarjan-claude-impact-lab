# Ghat Watch: copy to .env only if you want optional features. Nothing here is required.
# Optional AI layer (docs/METHOD-AI.md). Put real values in backend/.env (gitignored); never commit a key.
# With no keys every AI endpoint returns the checked standard (template) text.
# Claude reads uploaded PDFs/photos and is the text fallback.
ANTHROPIC_API_KEY=
GHATWATCH_CLAUDE_MODEL=
# Cerebras writes the short officer text (fast). Default model: gpt-oss-120b.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
# GHATWATCH_AI=0 forces template text everywhere, even with keys set.
GHATWATCH_AI=
# Optional LLM polish of the English brief (default off). Numbers are checked both ways; on mismatch the templated text is kept.
GHATWATCH_LLM_POLISH=0
# Override the served ML champion: logreg | random_forest | xgboost | lightgbm
GHATWATCH_MODEL=
# Comma-separated CORS origins for the API
GHATWATCH_CORS=http://localhost:3000,http://127.0.0.1:3000
# Optional voice (docs/METHOD-AI.md, "Voice"): ElevenLabs Hindi/English speech for the Listen buttons.
# Put the real key in backend/.env only; the browser never sees it. Without it the browser's own voice is used.
ELEVENLABS_API_KEY=
# Default eleven_multilingual_v2 (most natural Hindi). eleven_flash_v2_5 = lower latency, cheaper.
ELEVENLABS_MODEL=
# Default Hindi voice H6QPv2pQZDcGqLwDTIJQ (Kanika, voice library); default English JBFqnCBsd6RMkjVDRZzb (George).
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_VOICE_ID_EN=
# Frontend: API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
# Frontend: optional Mapbox public token (pk.*) for the dark base map. Put it in frontend/.env.local (gitignored).
# Without it the map uses keyless Stadia/Esri tiles, and offline it falls back to the schematic.
NEXT_PUBLIC_MAPBOX_TOKEN=
